# Kryptofolio Backend Environment Configuration

# -----------------------------------------------------------------------------
# DUAL-DB ARCHITECTURE PATHS
# -----------------------------------------------------------------------------

# File paths for the Dual-Database system
# VAULT_DB_PATH is for the SQLite DB containing encrypted API Keys & Config
VAULT_DB_PATH=../../kryptofolio.db

# DUCKDB_PATH is for the analytical engine where massive financial transactions are ingested
DUCKDB_PATH=../../fiscal.duckdb

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# Port for the Hono server to listen on
PORT=3001

# Enable mock mode (bypasses database and real APIs)
MOCK_MODE=false
