{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    // Fails the build if any file here imports from outside the package — including tests, which
    // `tsconfig.json` does not cover. A package reaching up into `apps/` cannot be expressed as a
    // workspace dependency (it would cycle), so turbo never invalidates its cache when the code it
    // reaches for changes: stale green runs.
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
