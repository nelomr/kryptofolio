{
  "name": "kryptofolio-workspace",
  "private": true,
  "version": "1.15.6",
  "description": "Kryptofolio - An open-source crypto portfolio tracker built with Vue 3.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nelomr/kryptofolio.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -F @kryptofolio/frontend dev",
    "dev:mock": "pnpm --parallel -F @kryptofolio/frontend -F @dashboar-portfolio/api-gateway dev",
    "build": "pnpm -F @kryptofolio/frontend build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r typecheck",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.3",
    "typescript": "~6.0.2"
  }
}
