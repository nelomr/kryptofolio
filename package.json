{
  "name": "kryptofolio-workspace",
  "private": true,
  "version": "1.15.10",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11.8.0"
  },
  "description": "Kryptofolio - A privacy-first, open-source crypto portfolio tracker and tax calculator powered by Vue 3, Hono, and DuckDB.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nelomr/kryptofolio.git"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm -F @kryptofolio/frontend dev",
    "dev:backend": "pnpm -F @kryptofolio/backend dev",
    "dev:full": "pnpm exec turbo run dev",
    "build": "pnpm exec turbo run build",
    "test": "vitest run",
    "test:packages": "pnpm exec turbo run test --concurrency=1",
    "typecheck": "pnpm exec turbo run typecheck",
    "lint": "pnpm exec turbo run lint",
    "prepare": "husky",
    "seed:parquet": "pnpm exec turbo run seed:parquet",
    "seed:ecb-rates": "pnpm exec turbo run seed:ecb-rates"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@fission-ai/openspec": "^1.3.1",
    "@types/node": "catalog:",
    "@types/papaparse": "5.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "tsx": "^4.19.2",
    "turbo": "^2.9.18",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@tanstack/vue-table": "8.21.3",
    "@tanstack/vue-virtual": "3.13.18",
    "papaparse": "5.4.1",
    "xlsx": "0.18.5"
  }
}
